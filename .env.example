# Real models; SDK credentials come from the named AWS CLI profile, never this file.
CONTEXTFORGE_AWS_PROFILE=contextforge
CONTEXTFORGE_AWS_REGION=ap-southeast-2
CONTEXTFORGE_MODEL_BACKEND=bedrock
# Stage models and their fallbacks come from config/models.yaml (any Bedrock model id with a
# price row there). A call moves to the next fallback while a model is down; a model that was
# down is tried last for 60 s. These optional overrides replace the planner's (plan, cite) or
# the executor's (execute) model, or its fallbacks (comma-separated, tried in order); left
# unset or empty, config/models.yaml's apply. Compress keeps its own. Kimi K3.1 as planner:
# CONTEXTFORGE_PLANNER_MODEL=global.moonshotai.kimi-k3.1
# CONTEXTFORGE_PLANNER_FALLBACKS=deepseek.v3.2,apac.amazon.nova-pro-v1:0
# CONTEXTFORGE_EXECUTOR_MODEL=mistral.mistral-large-3-675b-instruct
# CONTEXTFORGE_EXECUTOR_FALLBACKS=openai.gpt-oss-120b-1:0,apac.amazon.nova-pro-v1:0
# Read timeout per model call, by stage: plan and cite, then execute and compress.
CONTEXTFORGE_PLANNER_TIMEOUT_SECONDS=120
CONTEXTFORGE_EXECUTOR_TIMEOUT_SECONDS=60

# First slice: no uploads, embeddings or vector DB required.
CONTEXTFORGE_SEARCH_PROVIDER=duckduckgo
# Providers: duckduckgo, serper (Google-backed) or tavily; serper and tavily need your own key.
# A failed search is retried once, then tried on each other provider in the order tavily,
# serper, duckduckgo (tavily and serper only with a key).
# DuckDuckGo answers bursts of queries with a bot check (HTTP 202) that can last 20+ minutes.
SERPER_API_KEY=
# With a Tavily key, a page our own fetch cannot read (HTTP 401/403/429/5xx, a timeout, or
# almost no visible text) is read through Tavily Extract instead; each read costs credits.
TAVILY_API_KEY=

# Local single-user development. The CLI binds to 127.0.0.1.
CONTEXTFORGE_DEV_USER_ID=local-user
CONTEXTFORGE_CHECKPOINT_PATH=.data/checkpoints.sqlite
# JSON logs to terminal and this rotating local file (10 MB, three backups).
CONTEXTFORGE_BACKEND_LOG_PATH=backend.log
CONTEXTFORGE_CORS_ORIGINS=["http://localhost:5173"]
# Optional bearer token for API clients. The current EventSource UI assumes trusted localhost.
# CONTEXTFORGE_DEV_TOKEN=your-local-token

# Spend cap per request. A finished call costs its usage at the config/models.yaml prices. A call
# in flight holds its own worst case (context cap in, max tokens out; about $0.009 for
# gpt-oss-120b, $0.013 for Qwen3-235B, $0.047 for Nova Pro, $0.24 for Kimi K3.1); the reserve
# below stands in for a model without a price and is charged to a call whose usage is unknown
# (a timeout or an error). Each model a fallback tries is its own call against the cap.
CONTEXTFORGE_REQUEST_MAX_USD=1.0
CONTEXTFORGE_CALL_RESERVE_USD=0.10
CONTEXTFORGE_REQUEST_DEADLINE_SECONDS=900

# Default: application records/files are in memory; graph checkpoints are SQLite.
CONTEXTFORGE_BACKEND=memory
# AWS mode uses existing resources. Set backend=aws and the real queue URL.
CONTEXTFORGE_DYNAMODB_TABLE=contextforge
CONTEXTFORGE_S3_BUCKET=contextforge-441186132531-apse2
# CONTEXTFORGE_SQS_QUEUE_URL=https://sqs.ap-southeast-2.amazonaws.com/441186132531/contextforge-work

# Optional LangSmith traces: one tree per request run (plan, tasks, model and tool calls with
# tokens and estimated cost). Metadata only: the client hides inputs and outputs. No key is
# needed for the offline tests.
CONTEXTFORGE_MODEL_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=contextforge
# Do NOT set or export LANGSMITH_TRACING: it is the LangSmith SDK's global switch and would also
# trace LangGraph's full state (requests, page text, summaries). Use CONTEXTFORGE_MODEL_TRACING.
# Developer machine only: also put prompts and model and tool outputs on the runs. Keep it false
# wherever real user data flows.
CONTEXTFORGE_TRACE_CONTENT=false

# Deep Dive: store each model call's exact prompt and answer (system blocks, messages, tool
# results with fetched page text, the model's output) as JSON in the blob store, under
# transcripts/<requestId>/<modelCallId>.json, so the UI can show how a request was worked.
# Known secret values (the Serper, Tavily and LangSmith keys, the dev token) are redacted. Turn it off
# for a shared deployment: transcripts hold user data and page text.
CONTEXTFORGE_RECORD_TRANSCRIPTS=true

# Research quality: quote checks plus conservative claim/summary/assessment support review.
# Reviews and narrative writing use routed, metered model calls; missing reviews fail closed.
CONTEXTFORGE_VERIFY_WEB_CLAIMS=true
CONTEXTFORGE_RESEARCH_REPORTS=true
CONTEXTFORGE_WEB_TOOL_CALLS_PER_TASK=12
# The durable shared web-tool ceiling is webToolCallBudget in config/budgets.yaml (max 50).
# It is separate from callBudget, which counts model attempts.
