   );
 }
+
+function linkedSources(text: string) {
+  return text.split(/(\[source\]\(https?:\/\/[^)\s]+\))/g).map((part, index) => {
+    const match = /^\[source\]\((https?:\/\/[^)\s]+)\)$/.exec(part);
+    return match ? (
+      <a key={index} href={match[1]} target="_blank" rel="noopener noreferrer">
+        source
+      </a>
+    ) : (
+      part
+    );
+  });
+}
